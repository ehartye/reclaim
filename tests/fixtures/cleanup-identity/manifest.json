    "unicode-and-long-path", "file-id-replacement-or-reuse",
    "late-created-descendant", "changed-descendant", "tracked-source-content",
    "protected-content", "named-exclusion", "policy-generation-change",
    "external-conflicting-handle", "cancel", "helper-failure", "process-death",
    "unsupported-volume", "unsupported-reparse-state", "entry-limit",
    "handle-limit", "operation-budget", "drain-watchdog", "seeded-stress",
