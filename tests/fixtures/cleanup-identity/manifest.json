  "nativeBoundarySchedule": [
    "before-root-open", "after-root-open",
    "before-ancestor-open", "after-ancestor-open",
    "before-entry-open", "after-entry-open",
    "before-identity-check", "after-identity-check",
    "before-policy-check", "after-policy-check",
    "before-file-disposition", "after-file-disposition",
    "before-directory-removal", "after-directory-removal"
  ],
  "requiredCases": [
    "target-rename-and-reparse-replacement", "ancestor-rename-and-reparse-replacement",
